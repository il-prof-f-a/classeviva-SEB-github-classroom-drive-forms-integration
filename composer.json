{
  "name": "uda-smart/uda-system",
  "description": "Piattaforma per la gestione integrata delle Unità di Apprendimento",
  "type": "project",
  "license": "PolyForm-Noncommercial-1.0.0",
  "require": {
    "php": ">=8.2 <8.5",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*",
    "ext-zip": "*",
    "google/apiclient": "^2.18",
    "guzzlehttp/guzzle": "^7.10",
    "monolog/monolog": "^2.11",
    "phpmailer/phpmailer": "^7.0",
    "phpoffice/phpspreadsheet": "^1.30",
    "phpoffice/phpword": "^1.4",
    "smalot/pdfparser": "^2.12",
    "symfony/yaml": "^5.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "security": "composer validate --strict --no-check-publish && composer audit --locked && php tests/run.php"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}

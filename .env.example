# Applicazione
APP_DEBUG=false
APP_ENV=production
APP_URL=http://localhost:8080
ADMIN_EMAILS=email@email.it
LOCALE=it_IT
MAINTENANCE_MODE=false
SYSTEM_NAME="UDA Smart"
SYSTEM_VERSION=1.0.0
TIMEZONE=Europe/Rome
SESSION_IDLE_TIMEOUT=3600
# Accesso temporaneo durante la fase di test (lista separata da virgole)
TEST_ACCESS_NOTIFICATION_EMAIL=email@email.it
TEST_ALLOWED_EMAILS=email@email.it,email@email.it

# Database
DB_AUTO_INITIALIZE=true
DB_AUTO_REPAIR=true
DB_BACKUP_COMPRESS=true
DB_BACKUP_ENABLED=true
DB_BACKUP_FREQUENCY=daily
DB_BACKUP_PATH=database/backup/
DB_BACKUP_RETENTION_DAYS=30
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_DATABASE=uda_system
DB_HOST=127.0.0.1
DB_MAX_ROWS=10000
DB_PASSWORD=
DB_PORT=3306
DB_PREFIX=
DB_READ_ONLY=false
DB_SQLITE_FILE=database/uda.sqlite
DB_TYPE=sqlite
DB_USERNAME=uda_user

# Percorsi applicativi
PATH_BASE=
PATH_CACHE=storage/cache/
PATH_LOGS=storage/logs/
PATH_STORAGE=storage/
PATH_TEMP=storage/temp/
PATH_TEMPLATES=database/templates/
PATH_UDA_GRADES=voti/
PATH_UDA_MATERIALS=materiali/
PATH_UDA_PRESENTATIONS=presentazioni/
PATH_UDA_RUBRICS=rubriche/
PATH_UDA_STRUCTURE=storage/uda/{year}/{uda_id}/
PATH_UDA_TESTS=test/
PATH_UPLOADS=storage/uploads/

# Anno scolastico
ACADEMIC_YEAR_END=
ACADEMIC_YEAR_START=
CURRENT_ACADEMIC_YEAR=

# Crittografia (generare con: php -r "echo bin2hex(random_bytes(32));")
ENCRYPTION_KEY=

# Google OAuth e Workspace
GOOGLE_API_KEY=
GOOGLE_CLASSROOM_DEFAULT_NOTIFICATION=true
GOOGLE_CLASSROOM_DEFAULT_TOPIC_NAME=UDA
GOOGLE_CLASSROOM_ENABLED=false
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_DRIVE_CREATE_STRUCTURE=true
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME="UDA Smart"
GOOGLE_ENABLED=false
GOOGLE_FORMS_CREATE_FOR_TESTS=true
GOOGLE_FORMS_ENABLED=false
GOOGLE_LOGIN_REDIRECT_URI=
GOOGLE_REDIRECT_URI=
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_TEMPLATE_ID=
GOOGLE_TOKEN_FILE=config/google_token.json
GOOGLE_TOKEN_USER_ID=

# ClasseViva
CLASSEVIVA_BASE_URL=https://web.spaggiari.eu/rest/v1
CLASSEVIVA_ENABLED=false
CLASSEVIVA_MAX_RETRIES=3
CLASSEVIVA_RETRY_DELAY=1000
CLASSEVIVA_TIMEOUT=30

# GitHub Classroom
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Intelligenza artificiale
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email
MAIL_ENABLED=false
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="UDA Smart"
MAIL_HOST=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_TEST_RECIPIENT=
MAIL_USERNAME=

# Logging
LOG_ENABLED=true
LOG_FILE=storage/logs/app.log
LOG_LEVEL=info

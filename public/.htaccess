# Nessun rewrite necessario qui - i file PHP vengono serviti direttamente

# Nega accesso a file sensibili
<FilesMatch "\.(env|ini|log|sh|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Content-Type corretti
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
</IfModule>

# Il debug è controllato dal bootstrap e non viene mai attivato dal web server.

# Nega file applicativi e directory private se il server superiore non lo fa.
<FilesMatch "^(\.env|composer\.(json|lock)|.*\.(bak|db|sqlite|yaml|yml|json))$">
    Order allow,deny
    Deny from all
</FilesMatch>
